diff --git a/scripts/deploy-cloudrun.ps1 b/scripts/deploy-cloudrun.ps1
new file mode 100644
index 0000000..e1bc69b
--- /dev/null
+++ b/scripts/deploy-cloudrun.ps1
@@ -0,0 +1,86 @@
+<#
+.SYNOPSIS
+  Deploy God's Eye View to Google Cloud Run, password-gated.
+
+.DESCRIPTION
+  Cloud Run rather than static hosting because the app's whole API surface is
+  Vite plugin middleware; rather than Railway because that trial has expired.
+
+  Deploys a prebuilt image: GOOGLE_MAPS_API_KEY is baked into the browser
+  bundle at build time, so the image is built locally (or by CI) with that as a
+  build ARG and pushed, instead of built from source here.
+
+.EXAMPLE
+  .\scripts\deploy-cloudrun.ps1
+#>
+[CmdletBinding()]
+param(
+  [string]$Project = 'project-494b9eee-ced6-4525-aa8',
+  [string]$Region  = 'us-central1',
+  [string]$Service = 'gods-eye-view',
+  [string]$Image   = 'us-central1-docker.pkg.dev/project-494b9eee-ced6-4525-aa8/gev/gods-eye-view:v1'
+)
+
+$ErrorActionPreference = 'Stop'
+$repo = Split-Path -Parent $PSScriptRoot
+Set-Location $repo
+
+# Cloud Run supplies PORT and routes to it; .env pins HOST/PORT to localhost,
+# which would leave the container unreachable.
+$skip = @('HOST', 'PORT')
+$vars = @{}
+foreach ($line in Get-Content (Join-Path $repo '.env')) {
+  if ($line -match '^\s*#' -or $line -notmatch '=') { continue }
+  $i = $line.IndexOf('=')
+  $name = $line.Substring(0, $i).Trim()
+  $value = $line.Substring($i + 1).Trim()
+  if (-not $name -or -not $value -or $skip -contains $name -or $value -like 'PASTE_YOUR*') { continue }
+  $vars[$name] = $value
+}
+
+foreach ($required in @('GEV_AUTH_USER', 'GEV_AUTH_PASSWORD', 'GOOGLE_MAPS_API_KEY')) {
+  if (-not $vars[$required]) { throw "$required missing from .env - without the auth pair the deploy is PUBLIC." }
+}
+
+# Any Cloud Run URL, so the service works before its hostname is known. Vite
+# rejects unknown Host headers, which presents as a blank page on a healthy server.
+$vars['GEV_ALLOWED_HOSTS'] = '.run.app'
+
+# `--env-vars-file` is not accepted by this gcloud's `run deploy`, so use the
+# ^DELIM^ form: values here contain commas, which the default separator splits.
+if ($vars.Values | Where-Object { $_ -like '*##*' }) { throw 'A value contains the ## delimiter.' }
+$envArg = '^##^' + (($vars.GetEnumerator() | ForEach-Object { "$($_.Key)=$($_.Value)" }) -join '##')
+
+Write-Host "Deploying $Service to Cloud Run ($Region)..." -ForegroundColor Cyan
+gcloud run deploy $Service `
+  --image $Image `
+  --project $Project `
+  --region $Region `
+  --platform managed `
+  --allow-unauthenticated `
+  --memory 1Gi `
+  --cpu 1 `
+  --min-instances 0 `
+  --max-instances 3 `
+  --timeout 300 `
+  --set-env-vars $envArg `
+  --quiet
+if ($LASTEXITCODE -ne 0) { throw "gcloud run deploy failed ($LASTEXITCODE)" }
+
+$url = gcloud run services describe $Service --project $Project --region $Region --format='value(status.url)' 2>$null
+if (-not $url) { throw 'Deployed but could not read the service URL.' }
+
+# --allow-unauthenticated is deliberate: the app's own gate is the control, so
+# this must answer 401. A 200 means the gate never armed and the bundle -
+# which carries the Google key - is being served to anyone with the URL.
+$code = try { (Invoke-WebRequest $url -TimeoutSec 30 -SkipHttpErrorCheck).StatusCode } catch { 0 }
+
+Write-Host ""
+Write-Host "URL: $url" -ForegroundColor Green
+if ($code -eq 401) {
+  Write-Host "GATE CLOSED (401). Sign in as $($vars['GEV_AUTH_USER']) / $($vars['GEV_AUTH_PASSWORD'])" -ForegroundColor Green
+} elseif ($code -eq 200) {
+  Write-Warning 'PUBLIC (200) - the auth gate did NOT arm. Do not share this URL; check GEV_AUTH_* on the service.'
+} else {
+  Write-Warning "Unexpected status $code - check: gcloud run services logs read $Service --region $Region"
+}
diff --git a/scripts/deploy-railway.ps1 b/scripts/deploy-railway.ps1
new file mode 100644
index 0000000..58ab604
--- /dev/null
+++ b/scripts/deploy-railway.ps1
@@ -0,0 +1,81 @@
+<#
+.SYNOPSIS
+  Deploy God's Eye View to Railway, password-gated, in one command.
+
+.DESCRIPTION
+  Run `railway login` once first (browser OAuth; cannot be automated). Then this
+  script links a project, pushes every variable from .env, deploys, and verifies
+  the gate is closed.
+
+.EXAMPLE
+  railway login
+  .\scripts\deploy-railway.ps1
+#>
+[CmdletBinding()]
+param([string]$ProjectName = 'gods-eye-view')
+
+$ErrorActionPreference = 'Stop'
+$repo = Split-Path -Parent $PSScriptRoot
+Set-Location $repo
+
+if (-not (Get-Command railway -ErrorAction SilentlyContinue)) { throw 'Railway CLI missing: npm i -g @railway/cli' }
+railway whoami *> $null
+if ($LASTEXITCODE -ne 0) { throw 'Not logged in. Run: railway login' }
+
+# Parse .env, ignoring comments and blank lines.
+$envVars = @{}
+foreach ($line in Get-Content (Join-Path $repo '.env')) {
+  if ($line -match '^\s*#' -or $line -notmatch '=') { continue }
+  $name, $value = $line -split '=', 2
+  $name = $name.Trim(); $value = $value.Trim()
+  if ($name -and $value) { $envVars[$name] = $value }
+}
+
+foreach ($required in @('GOOGLE_MAPS_API_KEY', 'GEV_AUTH_USER', 'GEV_AUTH_PASSWORD')) {
+  if (-not $envVars[$required] -or $envVars[$required] -like 'PASTE_YOUR*') {
+    throw "$required is missing from .env. Without the auth pair the deploy is PUBLIC."
+  }
+}
+
+# HOST/PORT come from the platform, not the local file: .env pins them to
+# localhost:4173, which would make the container unreachable.
+'HOST', 'PORT' | ForEach-Object { $envVars.Remove($_) }
+
+if (-not (Test-Path (Join-Path $repo '.railway'))) {
+  Write-Host "Creating Railway project '$ProjectName'..." -ForegroundColor Cyan
+  railway init --name $ProjectName
+  if ($LASTEXITCODE -ne 0) { throw 'railway init failed' }
+}
+
+Write-Host "Pushing $($envVars.Count) variables..." -ForegroundColor Cyan
+$pairs = $envVars.GetEnumerator() | ForEach-Object { '--set'; "$($_.Key)=$($_.Value)" }
+railway variables @pairs | Out-Null
+if ($LASTEXITCODE -ne 0) { throw 'Failed to set variables' }
+
+Write-Host 'Deploying (build runs on Railway; first one takes a few minutes)...' -ForegroundColor Cyan
+railway up --detach
+if ($LASTEXITCODE -ne 0) { throw 'railway up failed' }
+
+$domain = (railway domain 2>&1 | Select-String -Pattern '[a-z0-9.-]+\.(up\.railway\.app|railway\.app)' |
+  ForEach-Object { $_.Matches[0].Value } | Select-Object -First 1)
+if (-not $domain) { Write-Warning 'No domain yet. Run `railway domain` to generate one, then re-run the checks below.'; return }
+
+$url = "https://$domain"
+Write-Host "`nDeployed: $url" -ForegroundColor Green
+Write-Host 'Waiting for the first response...' -ForegroundColor DarkGray
+
+$deadline = (Get-Date).AddMinutes(10)
+do {
+  Start-Sleep -Seconds 10
+  $code = try { (Invoke-WebRequest $url -TimeoutSec 10 -SkipHttpErrorCheck).StatusCode } catch { 0 }
+} until ($code -ne 0 -or (Get-Date) -gt $deadline)
+
+# A 200 here means the gate never armed and the bundle - which carries the
+# Google key - is being served to anyone with the URL.
+if ($code -eq 401) {
+  Write-Host "GATE CLOSED (401). Sign in as $($envVars['GEV_AUTH_USER']) / $($envVars['GEV_AUTH_PASSWORD'])" -ForegroundColor Green
+} elseif ($code -eq 200) {
+  Write-Warning "PUBLIC (200) - the auth gate did NOT arm. Check GEV_AUTH_* in `railway variables` before sharing this URL."
+} else {
+  Write-Warning "Unexpected status $code - check `railway logs`."
+}
diff --git a/scripts/qa-boot-smoke.mjs b/scripts/qa-boot-smoke.mjs
